# Load vendor data from file
def load_data(filename):

    vendors = []

    with open(filename, "r") as file:

        for line in file:
            parts = line.strip().split(",")

            vendor = {
                "id": parts[0],
                "name": parts[1],
                "year_week": parts[2],
                "vegan": int(parts[3]),
                "meat": int(parts[4]),
                "onions": float(parts[5]),
                "ketchup": float(parts[6])
            }

            vendors.append(vendor)

    return vendors

#linear search
def linear_search(data, target_name):

    for vendor in data:
        if vendor["name"] == target_name:
            return vendor

    return None

# Binary search (requires sorted data)
# Binary search returns only one matching record.
# Dataset contains multiple entries per vendor,
# so linear search is more suitable when all matches are required.
def binary_search(data, target_name):

    low = 0
    high = len(data) - 1

    while low <= high:

        mid = (low + high) // 2
        name = data[mid]["name"]

        if name == target_name:
            return data[mid]

        elif name < target_name:
            low = mid + 1

        else:
            high = mid - 1

    return None


# Bubble sort
def bubble_sort(data):

    n = len(data)

    for i in range(n):

        for j in range(0, n - i - 1):

            if data[j]["name"] > data[j + 1]["name"]:
                data[j], data[j + 1] = data[j + 1], data[j]

    return data


